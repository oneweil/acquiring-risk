{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/gate-shell.js",
        "timeout": 15
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/mark-edit.js",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/stop-ship-nudge.js",
        "timeout": 15,
        "loop_limit": 1
      }
    ]
  }
}
